{
  "license": "MPL-2.0",
  "links": [
    "libs/@types/gecko"
  ],
  "workspace": [
    "./libs/*",
    "./browser-features/*",
    "./bridge/*"
  ],
  "imports": {
    "@std/cli": "jsr:@std/cli@^1.0.28",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.23",
    "@std/path": "jsr:@std/path@^1.1.4",
    "#i18n/": "./i18n/",
    "#libs/": "./libs/",
    "#features-chrome/": "./browser-features/chrome/",
    "#bridge-loader-features/": "./bridge/loader-features/",
    "@nora/shared/": "./browser-features/shared/",
    "@mobily/ts-belt": "npm:@mobily/ts-belt@^3.13.1",
    "@std/streams": "jsr:@std/streams@^1.0.17",
    "@std/toml": "npm:@jsr/std__toml@^1.0.11",
    "@preact/signals-core": "npm:@preact/signals-core@^1.13.0",
    "vite": "npm:vite@^7.3.0"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "ESNext",
      "dom",
      "dom.asynciterable"
    ],
    "checkJs": true
  },
  "exclude": [
    "**/_dist/**/*",
    "libs/@types/gecko/**/*",
    "node_modules/**/*",
    "workflows/**/*",
    "generated/**/*",
    "gaji.config.ts"
  ],
  "tasks": {
    "feles-build": "ruby tools/feles-build.rb",
    "launcher": "ruby tools/launcher.rb",
    "test:tools": "ruby tools/test/dev_browser_test.rb",
    "drop:build": "ruby tools/scripts/build-drop.rb",
    "gha:dev": "gaji dev",
    "gha:build": "gaji build",
    "check:tabbrowser": "ruby tools/scripts/check-tabbrowser-methods.rb"
  },
  "nodeModulesDir": "auto",
  "vendor": true
}
